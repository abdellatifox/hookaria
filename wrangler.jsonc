{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hookaria",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },

  // 1) npx wrangler d1 create hookaria-db   -> paste the database_id below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hookaria-db",
      "database_id": "77fbb690-bbf6-4d4e-8c1a-1195449d84dd",
      "migrations_dir": "migrations"
    }
  ],

  // 2) npx wrangler kv namespace create CACHE   -> paste the id below
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "f98edfb29a2b43e9aa7a32feffb7c08e"
    }
  ]

  // 3) npx wrangler secret put ADMIN_TOKEN   (never commit it)
}
